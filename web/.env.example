# Copy to .env.local (git-ignored) and fill in. Server-only: never prefix these with NEXT_PUBLIC_,
# or Next.js bundles them into the browser code.

# Apps Script web app URL (Deploy → Manage deployments), ends in /exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Script property READ_TOKEN from Apps Script (feed reads only; never WRITE_TOKEN here)
READ_TOKEN=

# 1 = serve sample promos from lib/mockFeed.ts, no Apps Script needed (UI work)
FEED_MOCK=
